{
  "name": "@engritter/routerclaw",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "description": "Experimental per-message model and reasoning router. Requires the included, hash-pinned OpenClaw host adapter.",
  "author": "Álvaro Ritter — Safety Engenharia",
  "license": "MIT",
  "homepage": "https://engenharia.seg.br/",
  "repository": {
    "type": "git",
    "url": "https://github.com/engritter/routerclaw.git",
    "directory": "packages/routerclaw"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1 <27"
  },
  "bin": {
    "routerclaw": "./bin/routerclaw.mjs"
  },
  "scripts": {
    "prepack": "node ./lib/check-build.mjs"
  },
  "files": [
    "index.mjs",
    "bin/",
    "lib/",
    "adapter/",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ],
    "compat": {
      "pluginApi": "2026.11.1",
      "minGatewayVersion": "2026.11.1"
    },
    "build": {
      "openclawVersion": "2026.11.1"
    }
  }
}
